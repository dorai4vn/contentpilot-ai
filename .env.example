# ContentPilot AI — environment variables.
# Copy to .env.local for local development. NEVER commit real values.
# On Vercel: Project → Settings → Environment Variables (Production + Preview).

# Supabase project URL (Supabase → Project Settings → API / Data API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase *publishable* client key (sb_publishable_...). Safe to expose to the browser:
# all data access is enforced by Postgres Row Level Security.
# A legacy "anon" JWT key also works via NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional. Public origin used in sign-up confirmation emails, e.g. https://contentpilot-ai.vercel.app
# If unset, the origin of the incoming request is used.
NEXT_PUBLIC_SITE_URL=

# Do NOT add the Supabase service_role / secret key here: the app does not need it, and it
# bypasses Row Level Security. Server-only secrets (e.g. the AI provider key below)
# must never use the NEXT_PUBLIC_ prefix.

# --- M3 AI agent (server-only) -------------------------------------------------------------
# OpenAI API key. SECRET: set it only in .env.local (local) or in Vercel Environment
# Variables; never commit it and never prefix it with NEXT_PUBLIC_. Read only by
# src/lib/agent/config.ts ("server-only"). Leave empty to disable the AI agent.
OPENAI_API_KEY=

# OpenAI model used by the agent: any model your account can use that supports
# function calling, e.g. a small, low-cost one. Not a secret.
OPENAI_MODEL=

# --- RSS thể thao (server-only) ------------------------------------------------------------
# Cron bearer token. Set the same value as the GitHub secret SPORTS_NEWS_CRON_SECRET.
CRON_SECRET=
SPORTS_NEWS_WORKSPACE_ID=
SPORTS_NEWS_PROJECT_ID=
# Dedicated Supabase Auth account with the Member role in this workspace.
SPORTS_NEWS_WORKER_EMAIL=
SPORTS_NEWS_WORKER_PASSWORD=
SPORTS_NEWS_MIN_SCORE=8
SPORTS_NEWS_IMAGE_MODEL=gpt-image-1-mini
# Secret JSON object mapping publishing destination UUIDs to their respective tokens.
SPORTS_NEWS_SOCIAL_TOKENS={}
FACEBOOK_GRAPH_VERSION=v25.0
